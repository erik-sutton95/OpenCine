<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ReliabilityReporting watches the active network and the process-bound camera network. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- OperatorHaptics plays the AE lock double click on the vibrator. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- MonitorScreenRecording observes the optional API 35+ window callback. -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING" />
</manifest>
