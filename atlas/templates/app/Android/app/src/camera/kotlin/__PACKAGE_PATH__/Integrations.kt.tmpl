/**
 * The integrations this app ships (Swift `integrations()`), in the order the pair page lists
 * them: each an OpenCine integration with the app's typed slots, for example
 * `AppIntegration(integration, IntegrationSlots(pairing = { PairingTips() }))`. Empty until the app
 * has one; the `simulated` flavor lists the fake instead.
 */
fun integrations(): List<AppIntegration> = emptyList()
fun appIntegrations(activity: Activity): List<AppIntegration> = integrations()

fun makeOperatorMedia(context: Context, scope: CoroutineScope): MonitorOperatorMediaModel<MediaAsset, String>? = null

/** Bounded native adapters are supplied with a real integration. This list advertises no source. */
@Composable fun OperatorPicture(assist: MonitorAssistState, preferences: MonitorOperatorPreferences, iso: Int?) {}
@Composable fun OperatorThumbnail(record: MonitorMediaRecord<MediaAsset>) {}
@Composable fun OperatorPlaybackPicture(model: MonitorMediaPlaybackModel<MediaAsset, String>, assist: MonitorAssistState, preferences: MonitorOperatorPreferences) {}
@Composable fun OperatorAssistHost(): AssistHost = MonitorDefaultAssistHost
@Composable fun OperatorPlaybackEffects(assist: MonitorAssistState): FeedEffectsRenderPlan? = null
@Composable fun OperatorPlaybackPicture(model: MonitorMediaPlaybackModel<MediaAsset, String>, assist: MonitorAssistState,
    preferences: MonitorOperatorPreferences, effects: FeedEffectsRenderPlan?) {}
