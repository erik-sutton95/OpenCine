pluginManagement { repositories { google(); mavenCentral(); gradlePluginPortal() } }

dependencyResolutionManagement {
    repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
    repositories { google(); mavenCentral() }
    // OpenCine's own catalog, so this build resolves the same AGP, Kotlin, coroutines and Compose
    // as the modules it includes. Only what the app adds is declared here.
    versionCatalogs {
        create("libs") {
            from(files("../../OpenCine/Android/gradle/libs.versions.toml"))
            plugin("android-application", "com.android.application").versionRef("agp")
            library("activity-compose", "androidx.activity", "activity-compose").version("1.13.0")
        }
    }
}

rootProject.name = "__NAME__"
include(":app")

// The OpenCine platform build from the sibling checkout pinned in ../opencine-pins.txt. Named
// because its directory is also called Android.
includeBuild("../../OpenCine/Android") {
    name = "opencine"
    dependencySubstitution {
        substitute(module("com.opencapture.opencine:appkit")).using(project(":appkit"))
        substitute(module("com.opencapture.opencine:camera-controls")).using(project(":camera-controls"))
        substitute(module("com.opencapture.opencine:core")).using(project(":core"))
        substitute(module("com.opencapture.opencine:media")).using(project(":media"))
        substitute(module("com.opencapture.opencine:native-runtime")).using(project(":native-runtime"))
    }
}
