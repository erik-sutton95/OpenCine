name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  notes:
    name: Tester notes
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Present, and within the store limits
        run: |
          check() { test -s "$1" && [ "$(wc -m < "$1")" -le "$2" ] || { echo "$1: missing, empty or over $2 characters" >&2; exit 1; }; }
          check ios/TestFlight/WhatToTest.en-US.txt 4000
          check Android/Play/WhatToTest.en-US.txt 4000
          check Android/Play/whatsnew/whatsnew-en-US 500

  ios:
    name: iOS (both targets, SIMULATED contract test)
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: maxim-lobanov/setup-xcode@ed7a3b1fda3918c0306d1b724322adc0b8cc0a90 # v1
        with:
          xcode-version: latest-stable
      - name: OpenCine at the pinned commit
        run: scripts/checkout-opencine.sh
      - name: Project
        run: brew install xcodegen && (cd ios && xcodegen generate)
      - name: Build the shipping app
        run: xcodebuild -project ios/__NAME__.xcodeproj -scheme __NAME__ -destination 'generic/platform=iOS Simulator' build
      - name: SIMULATED contract test (private simulator)
        run: |
          udid=$(xcrun simctl create contract "iPhone 16 Pro")
          xcodebuild -project ios/__NAME__.xcodeproj -scheme __NAME__Simulated -destination "platform=iOS Simulator,id=$udid" test
          xcrun simctl delete "$udid"

  android:
    name: Android (unit tests, lint, assemble)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: OpenCine at the pinned commit
        run: scripts/checkout-opencine.sh
      - uses: actions/setup-java@de7274f081f381c8f8158605e0321c36c376e2e6 # v6.0.1
        with:
          distribution: temurin
          java-version: "21"
      - uses: gradle/actions/setup-gradle@3f5f9adaf7d9fecd50b5935e54106014257a94e6 # v6.4.0
      - name: Test, lint and assemble
        working-directory: Android
        run: ./gradlew test lint assembleSimulatedDebug assembleCameraRelease
